{
  "name": "@local/vsix-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Store, trust and enable VSIX extensions for DSH: search Open VSX and the Microsoft Marketplace, verify signatures, and install into the profile.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "src/*.js",
    "scripts/*.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
