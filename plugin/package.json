{
  "name": "dsh-vscode-extension-host",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "VS Code extensions for DSH, in one plugin: a VSIX store with trust gating, a real VS Code extension host that runs the installed extensions as extension code, and a stdio language-server provider.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "dist/",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "main-host.js",
    "src/*",
    "vendor/ATTRIBUTION.md",
    "vendor/LICENSE.vscode.txt",
    "webview-surface.js"
  ],
  "dependencies": {
    "dsh-vscode-protocol": "link:../packages/dsh-vscode-protocol",
    "dsh-lsp-stdio": "link:../lsp-stdio",
    "dsh-extension-console": "link:../extension-console",
    "dsh-vsix-store": "link:../vsix-store"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
