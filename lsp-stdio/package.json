{
  "name": "dsh-lsp-stdio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Makes ctx.lsp real: the LSP capability seam plus a stdio language-server provider, so definition / references / implementation / hover work against real language servers.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "Ethan Song",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "lsp",
    "language-server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colsonSung/dsh-vscode-ext-host.git",
    "directory": "lsp-stdio"
  },
  "homepage": "https://github.com/colsonSung/dsh-vscode-ext-host#readme"
}
