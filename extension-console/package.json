{
  "name": "dsh-extension-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Installed VS Code extensions and the Open VSX / Marketplace catalog on the Plugins page; DSH plugins stay in their own tabs.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale/*.json",
    "src/*"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
